PORT=4000

# Generate a real one before running this for real — e.g. `openssl rand -hex 32`
# or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# There is no fallback if this is unset: the server refuses to start rather
# than sign tokens with a value anyone reading this file could guess.
JWT_SECRET=

# Only needed if a separately hosted frontend must call this API
# cross-origin — the built frontend served by this same process, and the
# Vite dev server's own /api proxy, never need it. Comma-separated list of
# allowed origins, e.g.: https://plan-monitor.zou.ac.zw
CORS_ORIGIN=

# How many worker processes server.js forks — one per CPU core by default
# (see server.js's WORKER_COUNT), so this app actually uses every core the
# host has instead of just one. Set to 1 for simpler local debugging (a
# single process, no cluster indirection); leave unset in real deployment.
WEB_CONCURRENCY=

# --- Database (PostgreSQL) --------------------------------------------
# Either these PG* variables, or a single DATABASE_URL below, whichever is
# set — see backend/src/db.js. Local Postgres needs only these five and no
# SSL. See AZURE_SETUP.md for the Azure Database for PostgreSQL equivalents
# of these same variables (and why DB_SSL matters there) in production.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=zou_irbm

# Alternative to the PGHOST/PGPORT/... block above — a single connection
# string (e.g. postgresql://user:pass@host:5432/db?sslmode=require) takes
# precedence over the PG* variables when both are set.
# DATABASE_URL=

# Set true for a managed Postgres that requires TLS (Azure Database for
# PostgreSQL Flexible Server always does) — see AZURE_SETUP.md. Leave unset
# for local Postgres.
# DB_SSL=true

# Caps how many concurrent Postgres connections this whole process (all its
# workers combined) opens — see db.js's poolConfig.max. Leave unset for the
# default of 5.
DB_POOL_MAX=

# --- Microsoft Entra ID (Azure AD) sign-in for 'default'-role Individual
# accounts — leave all four unset to disable the feature entirely (GET
# /api/auth/azure/login then returns a clear 503 instead of crashing).
# See AZURE_SETUP.md for how to create the App Registration these come from.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:4000/api/auth/azure/callback
# Where the frontend lives — the browser is sent back here (with the app's
# own session token in the URL fragment) after a successful Microsoft
# sign-in. Defaults to '/' (this same process) if unset.
AZURE_POST_LOGIN_REDIRECT=http://localhost:5173/
